{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://rorica-aierp.vercel.app/a2a/schemas/order-intake.schema.json",
 "title": "接單：訂單（接單代理人 → 生管代理人）",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kind",
  "context_id",
  "order_no",
  "lines"
 ],
 "properties": {
  "kind": {
   "const": "order-intake"
  },
  "context_id": {
   "type": "string"
  },
  "order_no": {
   "type": "string"
  },
  "pi_id": {
   "type": "string"
  },
  "customer_id": {
   "type": "string"
  },
  "requested_delivery": {
   "type": "string",
   "format": "date"
  },
  "lines": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "line_no",
     "erp_product_name",
     "color",
     "qty_yd"
    ],
    "properties": {
     "line_no": {
      "type": "integer",
      "minimum": 1
     },
     "erp_product_name": {
      "type": "string"
     },
     "product_id": {
      "type": "string"
     },
     "color": {
      "type": "string"
     },
     "qty_yd": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "target_lab": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
     }
    }
   }
  }
 }
}
